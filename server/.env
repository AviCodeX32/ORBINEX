# ==============================================================================
# ORBINEX Server Configuration & Dependency Environment Variables
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
APP_NAME=ORBINEX
APP_DESCRIPTION="AI-Powered Opportunity Intelligence Platform"
APP_VERSION=1.0.0
DEBUG=True

# --- Server Host & Port Dependencies (Uvicorn / FastAPI) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_V1_PREFIX=/api/v1

# --- CORS & Client Origin Dependencies ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# --- Database Dependency (SQLAlchemy / SQLite / PostgreSQL) ---
# Default to high-performance local SQLite for instant zero-config startup, or switch to PostgreSQL
DATABASE_URL=sqlite:///./orbinex.db
# DATABASE_URL=postgresql+psycopg2://orbinex_user:orbinex_pass@localhost:5432/orbinex_db
DB_ECHO=False

# --- AI & LLM Provider Dependencies (Google Gemini / OpenAI / Fallback Engine) ---
# Primary AI Provider: "gemini" | "openai" | "fallback"
AI_PROVIDER=fallback
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=30

# --- Opportunity Discovery & Crawler Engine Dependencies ---
DISCOVERY_REFRESH_INTERVAL_MINUTES=60
DISCOVERY_MAX_PER_SOURCE=50
USER_AGENT_HEADER="ORBINEX-Bot/1.0 (+https://orbinex.ai/bot-info)"
HTTP_REQUEST_TIMEOUT=15

# --- Verification & Trust Scoring Engine ---
VERIFICATION_MIN_TRUST_SCORE=75
VERIFICATION_EXPIRATION_GRACE_HOURS=24
AUTO_VERIFY_KNOWN_DOMAINS=True

# --- Deduplication Engine Thresholds ---
DEDUPLICATION_SIMILARITY_THRESHOLD=0.82

# --- Background Task & Worker Configuration (Celery / Redis / ThreadPool) ---
REDIS_URL="redis://localhost:6379/0"
CELERY_ENABLED=False
ENABLE_BACKGROUND_CRON=True

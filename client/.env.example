# ==============================================================================
# ORBINEX Client Configuration & Dependency Environment Variables (Example)
# ==============================================================================

# --- React Vite Application Environment ---
VITE_NODE_ENV=development
VITE_APP_NAME=ORBINEX
VITE_APP_TAGLINE="AI-Powered Opportunity Intelligence Platform"
VITE_APP_VERSION=1.0.0

# --- Backend API Dependency (FastAPI / Uvicorn Server) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_HEALTH_URL=http://localhost:8000/api/v1/health

# --- Legacy / Next.js Compatibility Variables ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ORBINEX

# --- Platform Client Settings ---
VITE_ENABLE_AI_ASSISTANT=true
VITE_DEFAULT_STUDENT_ID=1
VITE_DEFAULT_CURRENCY=INR

# --- External Reference Platforms Integrations (Unstop, Devfolio, Devpost) ---
VITE_UNSTOP_INTEGRATION_ACTIVE=true
VITE_DEVFOLIO_INTEGRATION_ACTIVE=true
VITE_DEVPOST_INTEGRATION_ACTIVE=true

# --- UI & Analytics Dependencies ---
VITE_UI_THEME=light
VITE_ENABLE_ANALYTICS=true
